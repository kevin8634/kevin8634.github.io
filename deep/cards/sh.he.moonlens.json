{
  "id": "sh.he.moonlens",
  "world": "sh",
  "layer_name": "星河·成人",
  "link_task": "sh.moon",
  "tab": "拍月亮要多长焦",
  "uses": "星辰层弧度制与小角近似;相似三角形",
  "title": "手机拍月亮,要多长的镜头才能拍满画面?",
  "hook": "眼前的月亮又大又亮,拍出来却只是画面里的一个小白点。",
  "formula": "s=f\\,\\theta,\\quad\\theta=\\frac{D}{d}",
  "steps": [
    {
      "text": "月亮直径 D≈3475 km,平均距离 d≈384 400 km。小角近似下,它张开的角度 θ=D/d。",
      "tex": "\\theta=\\frac{3474.8}{384400}\\approx0.00904\\,\\text{rad}"
    },
    {
      "text": "换成角分约 31′,大约半度。伸直手臂,小指指甲盖就能挡住它。",
      "tex": "\\theta\\approx31'\\approx0.52^\\circ"
    },
    {
      "text": "镜头把角度变成底片上的长度:像的直径 s = 焦距 f × θ。",
      "tex": "s=f\\theta"
    },
    {
      "text": "常见手机主摄约等效 24 mm(全画幅 36×24 mm 口径):月亮的像只有 0.22 mm,不到画面高度的 1%。3000 像素高的照片里约 27 像素。",
      "tex": "24\\times0.00904\\approx0.22\\,\\text{mm}"
    },
    {
      "text": "等效 600 mm 长焦:像约 5.4 mm,占画面高度约 23%。",
      "tex": "600\\theta\\approx5.4\\,\\text{mm}"
    },
    {
      "text": "要让月亮顶满画面高度,需要约 2650 mm 的等效焦距。",
      "tex": "f=\\frac{24}{\\theta}\\approx2655\\,\\text{mm}"
    }
  ],
  "check": {
    "q": "焦距从 300 mm 换成 600 mm,月亮在照片里的直径会怎样?",
    "options": [
      "不变",
      "变成 2 倍",
      "变成 4 倍"
    ],
    "answer": 1,
    "why": "s=fθ,像的直径与焦距成正比;面积才是 4 倍。"
  },
  "lab": {
    "title": "焦距与月亮的大小",
    "note": "由总指挥添加,AI 协助编写。焦距按全画幅等效计,画面高度 24 mm;数码变焦只是裁切放大,不增加细节。月地距离 35.6–40.7 万千米(NASA)。",
    "params": [
      {
        "k": "f",
        "label": "等效焦距",
        "min": 13,
        "max": 3000,
        "step": 1,
        "value": 24,
        "unit": "mm"
      },
      {
        "k": "d",
        "label": "月地距离",
        "min": 356,
        "max": 407,
        "step": 1,
        "value": 384,
        "unit": "千千米"
      },
      {
        "k": "H",
        "label": "照片高度",
        "min": 1000,
        "max": 8000,
        "step": 100,
        "value": 3000,
        "unit": "像素"
      }
    ],
    "fn": {
      "x": "x",
      "from": 13,
      "to": 3000,
      "ys": [
        {
          "label": "月亮占画面高度(%)",
          "expr": "min(100,x*3474.8/(d*1000)/24*100)"
        }
      ],
      "mark": [
        {
          "x": "f",
          "label": "你的焦距"
        }
      ]
    },
    "readout": [
      {
        "label": "张角",
        "expr": "3474.8/(d*1000)*180/pi*60",
        "unit": "角分"
      },
      {
        "label": "像的直径",
        "expr": "f*3474.8/(d*1000)",
        "unit": "mm"
      },
      {
        "label": "占画面高度",
        "expr": "f*3474.8/(d*1000)/24*100",
        "unit": "%"
      },
      {
        "label": "约",
        "expr": "f*3474.8/(d*1000)/24*H",
        "unit": "像素"
      }
    ],
    "verdict": [
      {
        "when": "f*3474.8/(d*1000)/24-1",
        "text": "月亮比画面还高,只能拍到局部:等效 {{f}} mm 已超过顶满所需的 {{24/(3474.8/(d*1000))}} mm。"
      },
      {
        "when": "f*3474.8/(d*1000)/24-0.3",
        "text": "月亮约占画面高度 {{f*3474.8/(d*1000)/24*100}}%,环形山能拍出来了。"
      },
      {
        "when": "1",
        "text": "月亮只占画面高度约 {{f*3474.8/(d*1000)/24*100}}%,约 {{f*3474.8/(d*1000)/24*H}} 像素。不如把月亮放进风景里,拍它和地面的关系。"
      }
    ]
  },
  "pitfalls": [
    "数码变焦把像素放大,并不增加细节。",
    "近地点和远地点月亮的视直径相差约 12%,不是两倍。",
    "月亮很亮,自动曝光常把它拍成一团白;试着降低曝光。"
  ],
  "disclaimer": "只作科学演示;拍摄时注意安全,不要用相机直接对准太阳。",
  "textbook": "人教A版(2019)高中数学必修第一册 第五章 5.1.2 弧度制;人教版(2019)高中物理选择性必修第一册 第四章 光",
