   "duration_ms": 3318,
   "file_fx": "fx/a16.mp3",
   "duration_fx_ms": 3318
  },
  {
   "id": "a17",
   "group": "sentence",
   "text": "The wormhole is stable. Ahead lies the entrance to another universe.",
