 "items": [
  {
   "id": "a01",
   "group": "sentence",
   "text": "Welcome aboard the Starhelm, Explorer. I am JARVIS, your onboard intelligence. The stars are ready whenever you are.",
   "file": "dry/a01.mp3",
   "duration_ms": 7340,
   "file_fx": "fx/a01.mp3",
   "duration_fx_ms": 7314
  },
  {
   "id": "a02",
   "group": "sentence",
   "text": "Please select a target region on the star chart, or tell me which world you'd like to visit.",
   "file": "dry/a02.mp3",
   "duration_ms": 4885,
   "file_fx": "fx/a02.mp3",
   "duration_fx_ms": 4885
  },
  {
   "id": "a03",
   "group": "sentence",
   "text": "Please fasten your seatbelt. The Starhelm is about to depart.",
   "file": "dry/a03.mp3",
   "duration_ms": 3605,
   "file_fx": "fx/a03.mp3",
   "duration_fx_ms": 3579
  },
  {
   "id": "a04",
   "group": "sentence",
   "text": "Switching to cruise mode. Let's slow down and take in the stars around us.",
   "file": "dry/a04.mp3",
   "duration_ms": 4258,
   "file_fx": "fx/a04.mp3",
   "duration_fx_ms": 4258
  },
  {
   "id": "a05",
   "group": "sentence",
   "text": "Engine boost engaged. Hold on tight, we're about to chase the shadow of light.",
   "file": "dry/a05.mp3",
   "duration_ms": 4545,
   "file_fx": "fx/a05.mp3",
   "duration_fx_ms": 4571
  },
  {
   "id": "a06",
   "group": "sentence",
   "text": "Ignition in three, two, one. Launch!",
   "file": "dry/a06.mp3",
   "duration_ms": 3318,
   "file_fx": "fx/a06.mp3",
   "duration_fx_ms": 3318
  },
  {
   "id": "a07",
   "group": "sentence",
   "text": "Decelerating. Our destination is just ahead.",
   "file": "dry/a07.mp3",
   "duration_ms": 3527,
   "file_fx": "fx/a07.mp3",
   "duration_fx_ms": 3527
  },
  {
   "id": "a08",
   "group": "sentence",
   "text": "We have arrived and are entering orbit. Welcome to a new world.",
   "file": "dry/a08.mp3",
   "duration_ms": 4049,
   "file_fx": "fx/a08.mp3",
   "duration_fx_ms": 4049
  },
  {
   "id": "a09",
   "group": "sentence",
   "text": "I have the helm. Please make your way to the side viewport and enjoy the view.",
   "file": "dry/a09.mp3",
   "duration_ms": 5042,
   "file_fx": "fx/a09.mp3",
   "duration_fx_ms": 5016
  },
  {
   "id": "a10",
   "group": "sentence",
   "text": "Satellite cruise engaged. We'll complete one full orbit.",
   "file": "dry/a10.mp3",
   "duration_ms": 3944,
   "file_fx": "fx/a10.mp3",
   "duration_fx_ms": 3971
  },
  {
   "id": "a11",
   "group": "sentence",
   "text": "Control has been returned to you, Explorer.",
   "file": "dry/a11.mp3",
   "duration_ms": 2168,
   "file_fx": "fx/a11.mp3",
   "duration_fx_ms": 2168
  },
  {
   "id": "a12",
   "group": "sentence",
   "text": "Warning: extreme temperature ahead. Holding a safe distance automatically.",
   "file": "dry/a12.mp3",
   "duration_ms": 4624,
   "file_fx": "fx/a12.mp3",
   "duration_fx_ms": 4624
  },
  {
   "id": "a13",
   "group": "sentence",
   "text": "We're a little too close to this planet. Holding position for you.",
   "file": "dry/a13.mp3",
   "duration_ms": 3657,
   "file_fx": "fx/a13.mp3",
   "duration_fx_ms": 3657
  },
  {
   "id": "a14",
   "group": "sentence",
   "text": "Gravity slingshot trajectory plotted. Borrowing a planet's pull for a little extra speed.",
   "file": "dry/a14.mp3",
   "duration_ms": 5460,
   "file_fx": "fx/a14.mp3",
   "duration_fx_ms": 5460
  },
  {
   "id": "a15",
   "group": "sentence",
   "text": "Jump drive fully charged. Starlight is about to stretch into lines, so try not to blink.",
   "file": "dry/a15.mp3",
   "duration_ms": 5956,
   "file_fx": "fx/a15.mp3",
   "duration_fx_ms": 5956
  },
  {
   "id": "a16",
   "group": "sentence",
   "text": "Jump complete. We have crossed the regional boundary.",
